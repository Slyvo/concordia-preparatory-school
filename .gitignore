:root {
  --bg: #f7f5ef;
  --surface: #ffffff;
  --surface-soft: #f0f4f8;
  --primary: #1d3d72;
  --primary-dark: #12305e;
  --secondary: #d9a441;
  --text: #1f2937;
  --muted: #667085;
  --border: rgba(29, 61, 114, 0.08);
  --shadow: 0 18px 45px rgba(17, 24, 39, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
}

a {
  text-decoration: none;
  color: inherit;
}

img {
  max-width: 100%;
  display: block;
}

button,
input,
textarea {
  font: inherit;
}

.page-shell {
  min-height: 100vh;
}

.container {
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76px;
  gap: 24px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 700;
}

.brand strong,
.brand span {
  display: block;
}

.brand span {
  font-size: 0.76rem;
  color: var(--muted);
  font-weight: 500;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  display: grid;
  place-items: center;
  box-shadow: var(--shadow);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 22px;
  color: var(--muted);
  font-size: 0.94rem;
}

.nav-links a:hover {
  color: var(--primary);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 0.9rem 1.5rem;
  font-weight: 600;
  transition: all 0.2s ease;
  border: 1px solid transparent;
}

.button.small {
  padding: 0.7rem 1.15rem;
  font-size: 0.9rem;
}

.button.primary {
  background: var(--primary);
  color: white;
  box-shadow: 0 12px 25px rgba(29, 61, 114, 0.2);
}

.button.primary:hover {
  background: var(--primary-dark);
}

.button.secondary {
  border-color: rgba(29, 61, 114, 0.2);
  background: white;
  color: var(--primary);
}

.hero {
  padding: 96px 0 72px;
  background: linear-gradient(135deg, rgba(29, 61, 114, 0.12), rgba(217, 164, 65, 0.15));
}

.hero-inner {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  align-items: center;
  gap: 32px;
}

.eyebrow {
  margin: 0 0 16px;
  color: var(--secondary);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
  font-weight: 700;
}

.eyebrow.dark {
  color: var(--primary);
}

.hero h1,
.section h2 {
  margin: 0;
  font-size: clamp(2.3rem, 5vw, 4.2rem);
  line-height: 1.06;
  letter-spacing: -0.05em;
  color: var(--primary-dark);
}

.section h2 {
  font-size: clamp(2rem, 3vw, 2.8rem);
  letter-spacing: -0.04em;
}

.lead {
  margin: 22px 0 0;
  font-size: 1.08rem;
  color: var(--muted);
  max-width: 620px;
  line-height: 1.7;
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 28px;
}

.hero-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 28px;
  box-shadow: var(--shadow);
  padding: 28px 26px;
}

.card-label {
  margin: 0 0 20px;
  font-size: 0.83rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--secondary);
  font-weight: 700;
}

.hero-card ul {
  margin: 0;
  padding-left: 20px;
  color: var(--text);
  line-height: 2;
}

.stats {
  padding: 18px 0 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.stat-box {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 26px 20px;
  text-align: center;
  box-shadow: var(--shadow);
}

.stat-box strong {
  display: block;
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  color: var(--primary);
  margin-bottom: 8px;
}

.stat-box span {
  color: var(--muted);
  font-size: 0.95rem;
}

.section {
  padding: 96px 0;
}

.section.alt {
  background: rgba(29, 61, 114, 0.03);
}

.two-column,
.admissions-layout,
.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  align-items: center;
}

.two-column p,
.admissions-layout p,
.contact-layout p,
.news-card p,
.faculty-card p,
.info-card p,
.quote-card {
  color: var(--muted);
  line-height: 1.75;
}

.section-heading {
  margin-bottom: 30px;
}

.card-grid,
.faculty-grid,
.news-grid,
.testimonial-grid {
  display: grid;
  gap: 24px;
}

.card-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.info-card,
.news-card,
.quote-card,
.faculty-card {
  background: var(--surface);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: 22px;
  padding: 24px 22px;
}

.info-card h3,
.news-card h3,
.faculty-card h3 {
  margin: 0 0 12px;
  color: var(--primary-dark);
  font-size: 1.35rem;
}

.steps {
  display: grid;
  gap: 16px;
}

.step {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 18px 20px;
}

.step span {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  display: grid;
  place-items: center;
  font-weight: 700;
  flex-shrink: 0;
}

.step p {
  margin: 0;
  color: var(--text);
  line-height: 1.7;
}

.faculty-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.avatar {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  font-weight: 800;
  font-size: 1.2rem;
  margin-bottom: 16px;
}

.role {
  margin: 0 0 10px;
  color: var(--secondary);
  font-weight: 700;
}

.news-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.date {
  margin: 0 0 14px;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--secondary);
  font-weight: 700;
}

.testimonial-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.quote-card {
  margin: 0;
  font-size: 1.04rem;
}

.contact-list {
  list-style: none;
  padding: 0;
  margin: 22px 0 0;
  line-height: 2.2;
  color: var(--text);
}

.contact-form {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 24px;
  box-shadow: var(--shadow);
  padding: 24px;
  display: grid;
  gap: 16px;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  border: 1px solid rgba(29, 61, 114, 0.12);
  border-radius: 12px;
  background: var(--surface-soft);
  padding: 0.9rem 1rem;
  color: var(--text);
}

.contact-form input:focus,
.contact-form textarea:focus {
  outline: 2px solid rgba(29, 61, 114, 0.18);
  border-color: transparent;
}

.footer {
  background: var(--primary-dark);
  color: rgba(255, 255, 255, 0.8);
  padding: 24px 0;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

@media (max-width: 920px) {
  .nav {
    flex-wrap: wrap;
    padding: 18px 0;
  }

  .nav-links {
    width: 100%;
    justify-content: space-between;
    order: 3;
    overflow-x: auto;
    padding-bottom: 6px;
  }

  .hero-inner,
  .two-column,
  .admissions-layout,
  .contact-layout,
  .card-grid,
  .faculty-grid,
  .news-grid,
  .testimonial-grid,
  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .hero-inner {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .nav-links,
  .stats-grid,
  .card-grid,
  .faculty-grid,
  .news-grid,
  .testimonial-grid,
  .two-column,
  .admissions-layout,
  .contact-layout {
    grid-template-columns: 1fr;
  }

  .nav-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    font-size: 0.8rem;
  }

  .section {
    padding: 76px 0;
  }

  .hero {
    padding-top: 72px;
  }
}
